# Copy to .env (gitignored). docker-compose.yml reads it.

# Optional. Name on the phone menu when standalone (the admin page can also set it).
GAME_NAME=

# Optional. Leave empty to choose the admin password on /admin's first-run setup screen.
# Whoever completes setup first becomes admin, so do it right after deploying (or set this).
ADMIN_PASSWORD=

# Optional. Server time zone fallback (default America/New_York).
TZ=

# Optional. debug | info | warn | error (default info)
LOG_LEVEL=
